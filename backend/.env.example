# Banco local H2 por padrão. Para RDS PostgreSQL, substitua DB_URL e DB_USERNAME e preencha DB_PASSWORD.
# Exemplo RDS: jdbc:postgresql://SEU-ENDPOINT:5432/energiadc?sslmode=verify-full&sslrootcert=global-bundle.pem
DB_URL=jdbc:h2:file:./data/energiadc;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
SERVER_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:8443,http://127.0.0.1:8443
